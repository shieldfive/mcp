{
  "name": "@shieldfive/mcp",
  "version": "0.6.4",
  "type": "module",
  "description": "MCP server for your end-to-end encrypted ShieldFive vault: move files off your computer into it (each copy verified before the original moves, nothing deleted), find duplicates, reclaim space and reorganise. Decrypts on your machine; access is scoped, expiring, revocable and audited.",
  "license": "MIT",
  "author": "Cho Garcia <security@shieldfive.com>",
  "homepage": "https://github.com/shieldfive/mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shieldfive/mcp.git"
  },
  "bugs": {
    "url": "https://github.com/shieldfive/mcp/issues"
  },
  "keywords": [
    "claude",
    "disk-space",
    "duplicate-files",
    "encryption",
    "end-to-end-encryption",
    "filesystem",
    "mcp",
    "model-context-protocol",
    "post-quantum",
    "shieldfive",
    "vault"
  ],
  "bin": {
    "shieldfive-mcp": "src/server.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md",
    "server.json",
    "src"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "demo": "node demo/run-demo.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/keyring": "^2.1.0",
    "@shieldfive/crypto": "1.0.0-rc.6",
    "libsodium-wrappers-sumo": "^0.8.4",
    "zod": "^3.25.0"
  },
  "mcpName": "io.github.shieldfive/mcp"
}
